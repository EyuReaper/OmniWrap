# Database (Prisma) — validated at import time by lib/env.ts; missing required
# vars crash the process.
DATABASE_URL="postgresql://user:password@localhost:5432/omniwrap?schema=public"
# Used by prisma.config.ts for CLI/migrations when the primary URL is pooled.
DIRECT_URL="postgresql://user:password@localhost:5432/omniwrap?schema=public"

# NextAuth
NEXTAUTH_SECRET="your-nextauth-secret" # openssl rand -base64 32

# Encryption key for stored OAuth tokens (must be 64 hex chars = 32 bytes).
# Rotating it invalidates every stored Connection token — see
# docs/runbooks/postgres-backup-restore.md before touching backups.
ENCRYPTION_KEY="00112233445566778899aabbccddeeff00112233445566778899aabbccddeeff"

# OAuth providers (all currently required by lib/env.ts)
# Music
SPOTIFY_CLIENT_ID="your-spotify-id"
SPOTIFY_CLIENT_SECRET="your-spotify-secret"

# YouTube / Google
GOOGLE_CLIENT_ID="your-google-id"
GOOGLE_CLIENT_SECRET="your-google-secret"

# GitHub
GITHUB_CLIENT_ID="your-github-id"
GITHUB_CLIENT_SECRET="your-github-secret"

# Social (OAuth sign-in only today — no data fetcher yet)
LINKEDIN_CLIENT_ID="your-linkedin-id"
LINKEDIN_CLIENT_SECRET="your-linkedin-secret"

# Fitness
STRAVA_CLIENT_ID="your-strava-id"
STRAVA_CLIENT_SECRET="your-strava-secret"

# Stubs — optional until their integrations ship
TELEGRAM_CLIENT_ID=""
TELEGRAM_CLIENT_SECRET=""
TELEGRAM_WEBHOOK_SECRET=""
DUOLINGO_CLIENT_ID=""
DUOLINGO_CLIENT_SECRET=""
LETTERBOXD_CLIENT_ID=""
LETTERBOXD_CLIENT_SECRET=""

# App behaviour (optional)
# WRAP_YEAR=2025            # pin the wrap year (tests/CI); default: recap-season logic
# SENTRY_DSN=""             # enables error forwarding via lib/errorMonitoring.ts
