// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Account {
  id                String  @id @default(uuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  // Postgres does not index foreign keys automatically. NextAuth looks accounts
  // up by userId on every link, and `User` cascade-deletes scan this column.
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Same reason as Account.userId — plus session cleanup by user.
  @@index([userId])
}

model User {
  id            String       @id @default(cuid())
  name          String?
  email         String?      @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
  wraps         Wrap[]
  //for custom fields
  connections   Connection[]
  preferences   Json?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Wrap {
  id        String   @id @default(uuid())
  userId    String
  year      Int
  data      Json // Aggregated wrap data
  isPublic  Boolean  @default(false)
  shareId   String?  @unique // set on first share; stable across public/private toggles
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Every read path is (userId, year) or shareId, both covered by unique
  // indexes below. The userId prefix of this composite also serves
  // "all wraps for a user" (year selector, account deletion cascade).
  @@unique([userId, year])
}

model AuditLog {
  id        String   @id @default(cuid())
  // Deliberately not a foreign key to User: an audit record for
  // "account.delete" must survive the cascade delete of the user it
  // describes, or the compliance trail disappears at exactly the moment it
  // matters most. userEmail is a point-in-time snapshot for the same reason
  // — it stays readable after the user row (and its email) is gone.
  userId    String
  userEmail String?
  action    String // e.g. "connection.connect", "connection.disconnect", "account.delete"
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}

model Connection {
  id           String    @id @default(cuid())
  userId       String
  provider     String // e.g., "spotify", "strava"
  accessToken  String?   @db.Text //will be encrypted
  refreshToken String?   @db.Text //will be encrypted
  expiresAt    DateTime?
  metadata     Json? // stores things like spotify username, profile, pic
  // Used by manual (non-OAuth) providers like duolingo/telegram, whose
  // validity can't be derived from a token. OAuth providers derive live
  // status (connected/expired/error) from accessToken/expiresAt instead.
  status       String    @default("connected") // "connected" | "pending" | "error"
  lastError    String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Reads are either a single (userId, provider) lookup or "all connections
  // for a user" — the userId prefix of this composite covers both, so no
  // separate @@index([userId]) is needed.
  @@unique([userId, provider])
}
